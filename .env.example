# ---- Mode: production (Supabase) or local demo (zero-config) ----
# Use DATA_PROVIDER=supabase in production. Vercel fails closed if Supabase env is missing.
DATA_PROVIDER=demo

# ---- Sign-up policy ----
# Open by default: any valid email can sign in and sign up.
# Optional domain lock: set ALLOWED_EMAIL_DOMAINS to restrict who may use the system.
# "domain" = open; "invite" = require INVITE_CODE; "open" = open.
SIGNUP_MODE=domain
ALLOWED_EMAIL_DOMAINS=
INVITE_CODE=

# Demo mode only: the shared password every demo account uses to log in.
DEMO_PASSWORD=demo1234

# ---- Supabase (production) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: durable private storage for Demo Mode on Vercel.
# Supabase mode does not use this variable.
BLOB_READ_WRITE_TOKEN=

# ---- Google Gemini (photo/text extraction) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional project identifier for your Google AI project.
GEMINI_PROJECT_ID=